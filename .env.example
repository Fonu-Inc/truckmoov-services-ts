NODE_ENV=development

# HTTP ports
AUTH_PORT=3001
FLEET_PORT=3002

# Shared platform integration
NATS_URL=nats://localhost:4222
NATS_STREAM=truckmoov_events
DEFAULT_TENANT=default
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
JWT_SECRET=replace-me
PERSISTENCE_BACKEND=mikro-orm
SUPERADMIN_EMAIL=superadmin@truckmoov.com
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_FULL_NAME=Truckmoov Super Admin
SUPERADMIN_TENANT_ID=system

# Postgres (required when PERSISTENCE_BACKEND=mikro-orm)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=truckmoov
POSTGRES_PASSWORD=truckmoov
POSTGRES_DB=truckmoov

# Fleet runtime tuning
REPORT_INTERVAL_HOURS=24
ALERT_ESCALATION_MINUTES=30
DOCUMENT_RETENTION_DAYS=365
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
VEHICLE_HEALTH_THRESHOLD_MS=300000

# Fleet webhook verification
CPAAS_WEBHOOK_SECRET=
CPAAS_IP_ALLOWLIST=
ERP_WEBHOOK_SECRET=

# Shared object storage
OBJECT_STORAGE_PROVIDER=wasabi
OBJECT_STORAGE_REGION=eu-west-1
OBJECT_STORAGE_ENDPOINT=https://s3.eu-west-1.wasabisys.com
OBJECT_STORAGE_BUCKET=truckmoov-dev
OBJECT_STORAGE_PUBLIC_BUCKET=public-truckmoov-dev
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PUBLIC_BASE_URL=https://public-truckmoov-dev.s3.eu-west-1.wasabisys.com
OBJECT_STORAGE_PREFIX=dev/

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Auth email delivery
FRONTEND_URL=http://localhost:5173
MAIL_TRANSPORT=smtp
MAIL_FROM=hello@fonu.com
AWS_REGION=us-east-1
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=465
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
EMAIL_VERIFICATION_PATH=/auth/verify-email
INVITE_ACCEPT_PATH=/auth/invite

# SMS delivery
SMS_TRANSPORT=null
DOTGO_API_URL=
DOTGO_API_KEY=
DOTGO_SENDER_ID=TruckMoov

# Payments
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
EXCHANGE_RATE_API_KEY=
# Local only. In the cluster this comes from the fleet ConfigMap, and the
# code default is the in-cluster address.
AUTH_SERVICE_URL=http://localhost:3001
TENANT_STATUS_CACHE_SECONDS=30

# Mailbox aggregation. Off unless a deployment asks for it, so a local run does
# not start connecting to tenants' real mail servers.
MAILBOX_SYNC_ENABLED=false
MAILBOX_SYNC_INTERVAL_SECONDS=300
# IDLE holds one socket open per watched inbox for the life of the process.
MAILBOX_IDLE_ENABLED=false
MAILBOX_MAX_IDLE_CONNECTIONS=200

# Realtime gateway. Holds WebSocket connections; deliberately not autoscaled.
REALTIME_PORT=3006
REALTIME_MAX_CONNECTIONS=2000
REALTIME_DRAIN_SECONDS=10

# Live Tracking. Read by both fleet and realtime: fleet decides what a vehicle's
# status is, realtime paces the map frames, and the two must agree on the tick.
LIVE_TRACKING_FRAME_INTERVAL_MS=5000
# A vehicle with no fix inside this window reads as offline.
LIVE_TRACKING_OFFLINE_AFTER_MINUTES=15
# How often stale vehicles are swept into offline and dwell alerts are checked.
# Nothing arrives to trigger either when a device stops reporting.
LIVE_TRACKING_SWEEP_INTERVAL_SECONDS=30
