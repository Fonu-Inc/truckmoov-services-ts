FROM node:20-alpine AS base
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.build.json tsconfig.docker.json nest-cli.json ./
COPY apps/fleet ./apps/fleet
COPY libs ./libs
RUN corepack enable && NODE_OPTIONS=--max-old-space-size=256 pnpm install --frozen-lockfile
RUN sed -i 's/"tsConfigPath": "tsconfig.json"/"tsConfigPath": "tsconfig.docker.json"/g' nest-cli.json \
    && NODE_OPTIONS=--max-old-space-size=256 pnpm build:fleet
RUN NODE_OPTIONS=--max-old-space-size=256 pnpm prune --prod

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/dist ./dist
EXPOSE 3002
CMD ["node", "dist/apps/fleet/src/main.js"]
