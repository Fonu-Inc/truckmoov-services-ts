FROM node:20-alpine AS base
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.build.json nest-cli.json ./
COPY apps ./apps
COPY libs ./libs
RUN corepack enable && pnpm install --frozen-lockfile
RUN NODE_OPTIONS=--max-old-space-size=512 pnpm build:fleet

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile --prod --node-linker=hoisted
COPY --from=base /app/dist ./dist
EXPOSE 3002
CMD ["node", "dist/apps/fleet/src/main.js"]
