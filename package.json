{
  "name": "truckmoov-services-ts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build auth && nest build fleet",
    "start:auth": "nest start auth --watch",
    "start:fleet": "nest start fleet --watch",
    "dev": "concurrently -k \"pnpm start:auth\" \"pnpm start:fleet\"",
    "start:auth:prod": "node dist/apps/auth/src/main.js",
    "start:fleet:prod": "node dist/apps/fleet/src/main.js",
    "lint": "tsc --noEmit && eslint .",
    "lint:eslint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:interface": "vitest run tests/interface",
    "test": "pnpm test:unit && pnpm test:interface",
    "migration:run": "node -e \"console.log('MikroORM schema sync is enabled in persistence adapters for this bootstrap.')\"",
    "migration:revert": "node -e \"console.log('MikroORM rollback is not wired in this bootstrap yet.')\""
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1005.0",
    "@mikro-orm/core": "^6.5.5",
    "@mikro-orm/postgresql": "^6.5.5",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/swagger": "^7.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "nats": "^2.29.3",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.20",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.0.3",
    "supertest": "^7.1.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.15.0"
}
