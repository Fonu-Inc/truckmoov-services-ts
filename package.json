{
  "name": "truckmoov-services-ts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky || true",
    "commitlint": "commitlint --edit",
    "build": "nest build auth && nest build fleet && nest build realtime",
    "build:auth": "nest build auth",
    "build:fleet": "nest build fleet",
    "start:auth": "nest start auth --watch",
    "start:fleet": "nest start fleet --watch",
    "dev": "concurrently -k \"pnpm start:auth\" \"pnpm start:fleet\"",
    "start:auth:prod": "node dist/apps/auth/src/main.js",
    "start:fleet:prod": "node dist/apps/fleet/src/main.js",
    "lint": "tsc --noEmit && eslint .",
    "typecheck": "tsc --noEmit",
    "lint:auth": "eslint apps/auth libs/shared tests/interface/auth tests/unit/auth",
    "lint:fleet": "eslint apps/fleet libs/shared tests/interface/fleet tests/unit/fleet",
    "lint:realtime": "eslint apps/realtime libs/shared tests/unit/realtime",
    "lint:eslint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:unit:auth": "vitest run tests/unit/auth",
    "test:interface": "vitest run tests/interface",
    "test:interface:auth": "vitest run tests/interface/auth",
    "test:auth": "vitest run tests/unit/auth tests/interface/auth",
    "test:fleet": "vitest run tests/unit/fleet tests/interface/fleet",
    "test:realtime": "vitest run tests/unit/realtime",
    "test:shared": "vitest run tests/unit/shared",
    "test": "pnpm test:unit && pnpm test:interface",
    "test:db": "vitest run -c vitest.db.config.ts",
    "migration:generate:auth": "mikro-orm migration:create --config apps/auth/mikro-orm.config.ts",
    "migration:generate:fleet": "mikro-orm migration:create --config apps/fleet/mikro-orm.config.ts",
    "migration:run:auth": "mikro-orm migration:up --config apps/auth/mikro-orm.config.ts",
    "migration:run:fleet": "mikro-orm migration:up --config apps/fleet/mikro-orm.config.ts",
    "migration:revert:auth": "mikro-orm migration:down --config apps/auth/mikro-orm.config.ts",
    "migration:revert:fleet": "mikro-orm migration:down --config apps/fleet/mikro-orm.config.ts",
    "migration:run": "pnpm migration:run:auth && pnpm migration:run:fleet",
    "build:realtime": "nest build realtime",
    "start:realtime": "nest start realtime --watch",
    "start:realtime:prod": "node dist/apps/realtime/src/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/client-ses": "^3.1005.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@mikro-orm/core": "^6.5.5",
    "@mikro-orm/migrations": "^6.6.9",
    "@mikro-orm/postgresql": "^6.5.5",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.4.22",
    "@sentry/node": "^10.43.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "axios": "^1.18.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "^4.4.0",
    "imapflow": "^1.7.6",
    "ioredis": "^6.0.0",
    "mailparser": "^3.14.3",
    "nats": "^2.29.3",
    "nodemailer": "^10.5.0",
    "pdf-lib": "^1.17.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19",
    "@commitlint/config-conventional": "21",
    "@mikro-orm/cli": "^6.6.9",
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.20",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "supertest": "^7.1.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@mikro-orm/core@>=6.0.0 <6.6.10": "^6.6.10",
      "@mikro-orm/knex@>=6.0.0 <6.6.14": "^6.6.14",
      "axios@>=1.0.0 <1.20.0": "^1.20.0",
      "body-parser@>=1.0.0 <1.20.9": "^1.20.9",
      "brace-expansion@>=1.0.0 <1.1.20": "^1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6",
      "brace-expansion@>=5.0.0 <5.0.11": "^5.0.11",
      "engine.io@>=6.0.0 <6.6.10": "^6.6.10",
      "fast-xml-builder@>=1.0.0 <1.1.7": "^1.1.7",
      "fast-xml-parser@>=5.0.0 <5.5.6": "^5.5.6",
      "follow-redirects@>=1.0.0 <1.16.2": "^1.16.2",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "lodash@>=4.0.0 <4.18.0": "^4.18.0",
      "multer@>=2.0.0 <2.5.0": "^2.5.0",
      "path-to-regexp@>=0.0.0 <0.1.13": "^0.1.13",
      "picomatch@>=2.0.0 <2.3.2": "^2.3.2",
      "proxy-addr@>=2.0.0 <2.0.8": "^2.0.8"
    }
  }
}
