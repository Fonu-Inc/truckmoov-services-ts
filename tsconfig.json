{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "incremental": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/config": ["libs/shared/config/src"],
      "@shared/logger": ["libs/shared/logger/src"],
      "@shared/db": ["libs/shared/db/src"],
      "@shared/rbac": ["libs/shared/rbac/src"],
      "@shared/http": ["libs/shared/http/src"],
      "@shared/openapi": ["libs/shared/openapi/src"],
      "@shared/eventbus": ["libs/shared/eventbus/src"],
      "@shared/mailer": ["libs/shared/mailer/src"]
    }
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
