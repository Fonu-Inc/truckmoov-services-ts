{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "incremental": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/config": ["libs/shared/config/src"],
      "@shared/logger": ["libs/shared/logger/src"],
      "@shared/db": ["libs/shared/db/src"],
      "@shared/rbac": ["libs/shared/rbac/src"],
      "@shared/http": ["libs/shared/http/src"],
      "@shared/openapi": ["libs/shared/openapi/src"],
      "@shared/observability": ["libs/shared/observability/src"],
      "@shared/metrics": ["libs/shared/metrics/src"],
      "@shared/eventbus": ["libs/shared/eventbus/src"],
      "@shared/mailer": ["libs/shared/mailer/src"],
      "@shared/object-storage": ["libs/shared/object-storage/src"],
      "@shared/sms": ["libs/shared/sms/src"],
      "@shared/crypto": ["libs/shared/crypto/src"],
      "@shared/csv": ["libs/shared/csv/src"],
      "@shared/devices": ["libs/shared/devices/src"],
      "@shared/audit": ["libs/shared/audit/src"],
      "@shared/identity": ["libs/shared/identity/src"],
      "@shared/access": ["libs/shared/access/src"],
      "@shared/pagination": ["libs/shared/pagination/src"],
      "@shared/nigeria": ["libs/shared/nigeria/src"],
      "@auth/session": ["apps/auth/src/contexts/auth/session"],
      "@auth/session/*": ["apps/auth/src/contexts/auth/session/*"],
      "@auth/installation": ["apps/auth/src/contexts/installation"],
      "@auth/installation/*": ["apps/auth/src/contexts/installation/*"],
      "@auth/onboarding": ["apps/auth/src/contexts/onboarding"],
      "@auth/onboarding/*": ["apps/auth/src/contexts/onboarding/*"],
      "@fleet/shared/*": ["apps/fleet/src/contexts/fleet/shared/*"],
      "@auth/templates/*": ["apps/auth/src/templates/*"]
    }
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
